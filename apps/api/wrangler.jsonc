{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-visit-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "vars": {
    "TELEGRAM_CLIENT_ID": "",
    "WEB_ORIGINS": ""
  },
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "15001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AUTH_GLOBAL_LIMITER",
      "namespace_id": "15002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales-visit",
      "database_id": "c4af99fa-e52e-4329-b04e-5d92598c63da",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
