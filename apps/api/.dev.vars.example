# Local Wrangler overrides only. Copy to apps/api/.dev.vars; never commit that file.
# Leave the production vars in wrangler.jsonc unchanged.
WEB_ORIGINS="http://localhost:5173"
APP_ENV="local"
DEMO_AUTH_ENABLED="true"

# Optional for Web login: your separate test bot's BotFather OIDC Client ID.
# Empty disables Telegram Login only. Demo Login needs neither OIDC nor Bot startup.
TELEGRAM_CLIENT_ID=""
