{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-visit-api-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.staging.example.invalid", "custom_domain": true },
  ],
  "vars": {
    "APP_ENV": "staging",
    "DEMO_AUTH_ENABLED": "true",
    "TELEGRAM_CLIENT_ID": "",
    "WEB_ORIGINS": "https://staging.example.invalid",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales-visit-staging",
      "database_id": "REPLACE_WITH_NEW_STAGING_D1_UUID",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "observability": { "enabled": true },
}
