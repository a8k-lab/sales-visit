{
  "name": "@sales-visit/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seeds/local.sql",
    "deploy": "node ../../scripts/cloudflare-remote.mjs deploy-api",
    "cf-typegen": "wrangler types --env-interface ApiBindings --strict-vars=false"
  },
  "dependencies": {
    "@sales-visit/contracts": "workspace:*",
    "@sales-visit/db": "workspace:*",
    "hono": "^4.13.16",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@hono/cli": "1.0.0-rc.8",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261102.0-beta",
    "wrangler": "^4.110.0"
  }
}
