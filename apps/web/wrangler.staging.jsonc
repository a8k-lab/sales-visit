{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-visit-web-staging",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "staging.example.invalid", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
