{
  "name": "@sales-visit/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "node ../../scripts/cloudflare-deploy.mjs bot",
    "cf-typegen": "pnpm --filter @sales-visit/api cf-typegen && wrangler types --env-interface CloudflareBindings -c wrangler.jsonc -c ../api/wrangler.jsonc",
    "typecheck": "pnpm cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sales-visit/contracts": "workspace:*",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.156.2"
  }
}
