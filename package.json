{
  "name": "sales-visit",
  "version": "0.0.0",
  "description": "A monorepo for Sales Visit app",
  "scripts": {
    "dev:web": "pnpm --filter @sales-visit/web dev",
    "build:web": "pnpm --filter @sales-visit/web build",
    "deploy:web": "pnpm --filter @sales-visit/web run deploy",
    "preview:web": "pnpm build:web && pnpm --filter @sales-visit/web preview:worker",
    "dev:api": "pnpm --filter @sales-visit/api dev",
    "deploy:api": "pnpm --filter @sales-visit/api run deploy",
    "deploy:bot": "pnpm --filter @sales-visit/bot run deploy",
    "db:migrate:remote": "node scripts/cloudflare-remote.mjs migrate-remote",
    "db:verify:remote": "node scripts/cloudflare-remote.mjs verify-remote",
    "test:deployment": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p '*_test.py'",
    "telegram:test-bot": "python3 scripts/telegram-test-bot.py",
    "db:migrate:local": "pnpm --filter @sales-visit/api db:migrate:local",
    "db:seed:local": "pnpm --filter @sales-visit/api db:seed:local",
    "dev:bot": "pnpm --filter @sales-visit/bot dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.1"
}
