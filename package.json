{
  "name": "sales-visit",
  "version": "0.0.0",
  "description": "A monorepo for Sales Visit app",
  "scripts": {
    "dev:web": "pnpm --filter @sales-visit/web dev",
    "dev:api": "pnpm --filter @sales-visit/api dev",
    "dev:bot": "pnpm --filter @sales-visit/bot dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.1"
}
